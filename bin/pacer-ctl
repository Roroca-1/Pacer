#!/bin/sh
# pacer-ctl up|down|toggle|on|off|set N|mode [name]|status [--key KEY]
HERE=$(dirname "$(readlink -f "$0")")
for d in "$HERE/../gui" "$HERE/../share/pacer/gui" "${XDG_DATA_HOME:-$HOME/.local/share}/pacer/gui"; do
  [ -f "$d/pacer/ctl.py" ] && { PYTHONPATH="$d${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m pacer.ctl "$@"; }
done
echo "pacer-ctl: files not found" >&2; exit 1
