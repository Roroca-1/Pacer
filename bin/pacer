#!/bin/sh
# pacer GUI launcher
HERE=$(dirname "$(readlink -f "$0")")
for d in "$HERE/../gui" "$HERE/../share/pacer/gui" "${XDG_DATA_HOME:-$HOME/.local/share}/pacer/gui"; do
  [ -f "$d/pacer/app.py" ] && { PYTHONPATH="$d${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m pacer.app "$@"; }
done
echo "pacer: GUI files not found" >&2; exit 1
